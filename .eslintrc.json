{
  "root": true,
  "env": { "browser": true, "es2021": true },
  "extends": "eslint:recommended",
  "globals": { "JSZip": "readonly", "mammoth": "readonly" },
  "rules": {
    "no-unused-vars": "off",
    "no-empty": "off",
    "no-func-assign": "off",
    "no-redeclare": "off",
    "no-inner-declarations": "off"
  }
}
